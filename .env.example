# Not Your GiG — repo-root environment
# Frontend (Vite) variables now live in frontend/.env (vite.config.ts uses
# `envDir: "."`). On Vercel they are set per-project in the dashboard.
# The following are still read from this root .env by the BACKEND
# (backend/src/... via ConfigModule envFilePath [".env", "../.env"]).
# Copy this file to `.env` and paste the real values.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CLERK_SECRET_KEY=

# GitHub proof-of-work verification (separate from Clerk auth). Additive.
# See backend/.env for full annotation of these values.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must match a callback URL registered on the GitHub OAuth App.
GITHUB_REDIRECT_URI=https://not-your-gig.vercel.app/api/auth/github/callback
# Where the browser is sent after connecting, with ?github=verified|none|error.
GITHUB_SUCCESS_REDIRECT_URL=https://not-your-gig.vercel.app/dashboard/profile
# Optional: signs the OAuth state cookie. Falls back to GITHUB_CLIENT_SECRET.
# GITHUB_STATE_SECRET=
# CORS origin for the frontend (comma-separated). Unset => allow all (local dev).
# FRONTEND_URL=https://not-your-gig.vercel.app