# Not Your GiG — repo-root environment
# VITE_CLERK_PUBLISHABLE_KEY is read from THIS file (repo root), NOT frontend/.env,
# because frontend/vite.config.ts sets `envDir: ".."`.
# Inlined by Vite into the bundle at dev/build time (frontend/src/lib/clerk-config.ts).
#
# Copy this file to `.env` and paste your Clerk publishable key.
# Get one at https://dashboard.clerk.com (it's the "pk_..." value).

VITE_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY