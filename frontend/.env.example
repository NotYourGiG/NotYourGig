# Not Your GiG — frontend (Vite) environment
# Read from THIS folder during `npm run dev` / `npm run build`
# (vite.config.ts sets `envDir: "."`).
#
# Copy this file to `.env` and paste your keys. On Vercel, set the same
# variables in the frontend project's Environment Variables instead.

# Clerk publishable key — get one at https://dashboard.clerk.com ("pk_...").
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY

# Deployed backend API base. IMPORTANT — must be the BACKEND project's URL
# (origin + /api), NOT the frontend's URL. The backend has a global "api"
# prefix, so every route lives under /api.
#
#   WRONG (frontend domain, no /api):  VITE_API_URL=https://not-your-gig.vercel.app
#   WRONG (no /api path):              VITE_API_URL=https://nyg-backend.vercel.app
#   CORRECT:                           VITE_API_URL=https://nyg-backend.vercel.app/api
#
# You can verify the backend URL by opening /api/health in the browser:
#   https://nyg-backend.vercel.app/api/health  ->  {"status":"ok",...}
# Leave unset in local dev — the Vite /api proxy targets localhost:3000.
VITE_API_URL=