# Not Your GiG — backend (NestJS) environment
# Read by backend/src/supabase/supabase.service.ts and backend/src/auth/auth.service.ts
# via ConfigModule (envFilePath: [".env", "../.env"]).
#
# Copy this file to `.env` and paste the real values:

SUPABASE_URL=your-supabase-project-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
CLERK_SECRET_KEY=your-clerk-secret-key

# GitHub proof-of-work verification (separate from Clerk auth). Get a Client
# ID/Secret at github.com/settings/developers, scopes read:user public_repo.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must match a callback URL registered on the GitHub OAuth App.
GITHUB_REDIRECT_URI=https://nyg-backend.vercel.app/api/auth/github/callback
# Where the browser is sent after connecting, with ?github=verified|none|error.
GITHUB_SUCCESS_REDIRECT_URL=https://nyg-frontend.vercel.app/dashboard/profile
# Optional: signs the OAuth state cookie. Falls back to GITHUB_CLIENT_SECRET.
# GITHUB_STATE_SECRET=

# Comma-separated list of allowed browser origins for CORS.
# On Vercel set this to your deployed frontend, e.g.
# FRONTEND_URL=https://nyg-frontend.vercel.app
# When unset the backend allows all origins (local dev default).
# FRONTEND_URL=https://nyg-frontend.vercel.app