# Not Your GiG — backend (NestJS) environment
# Read by backend/src/supabase/supabase.service.ts and backend/src/auth/auth.service.ts
# via ConfigModule (envFilePath: [".env", "../.env"]).
#
# Copy this file to `.env` and paste the real values:

SUPABASE_URL=your-supabase-project-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
CLERK_SECRET_KEY=your-clerk-secret-key

# Comma-separated list of allowed browser origins for CORS.
# On Vercel set this to your deployed frontend, e.g.
# FRONTEND_URL=https://nyg-frontend.vercel.app
# When unset the backend allows all origins (local dev default).
# FRONTEND_URL=https://nyg-frontend.vercel.app